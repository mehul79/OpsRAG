# LLM: any OpenAI-compatible endpoint. OpenRouter:
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash

# LLM judge for evals/run.py --judge (keep it a different model from LLM_MODEL)
JUDGE_MODEL=openai/gpt-6-luna

# Reranker: local (ms-marco-MiniLM-L-6-v2 on CPU, no key) or cohere (needs COHERE_API_KEY).
RERANKER=local
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v5.0-fast

# Tracing (Langfuse Cloud: Settings -> API keys). Leave empty to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM_REASONING=on re-enables the model's hidden reasoning (off by default on OpenRouter: faster and cheaper)
# Set to off to skip the LLM query rewrite (saves ~5s; evals showed no recall gain yet)
QUERY_TRANSFORM=on

# Prompt router: on|off (default on). Skips retrieval for chitchat / about-the-bot / non-infra prompts (needs backend/router_weights.npz).
# ROUTER_MIN is the confidence needed to skip; the default comes from evals/router_eval.py.
ROUTER=on
# ROUTER_MIN=0.8

# Online evals: grade each fresh answer in the background with JUDGE_MODEL (a few judge calls per answer). ONLINE_EVAL_RATE samples 0..1.
ONLINE_EVAL=on
# ONLINE_EVAL_RATE=1

QDRANT_URL=http://localhost:6333
