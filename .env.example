# LLM
LLM_BASE_URL=https://openrouter.ai/api/v1   # OpenAI-compatible endpoint
LLM_API_KEY=                                 # Key for that endpoint
LLM_MODEL=deepseek/deepseek-v4.1-flash          # Answer model
JUDGE_MODEL=openai/gpt-6-luna                   # Eval judge model

# Vector DB
QDRANT_URL=http://localhost:6333                # Qdrant endpoint
QDRANT_API_KEY=                                 # Qdrant Cloud key (empty for local)

# Reranker
RERANKER=local                                  # local or cohere
COHERE_API_KEY=                                 # Only if RERANKER=cohere
COHERE_RERANK_MODEL=rerank-v5.0-fast            # Cohere rerank model

# Langfuse tracing
LANGFUSE_PUBLIC_KEY=                            # Langfuse public key
LANGFUSE_SECRET_KEY=                            # Langfuse secret key
LANGFUSE_BASE_URL=https://cloud.langfuse.com    # Langfuse host

# Pipeline switches
QUERY_TRANSFORM=on                              # LLM query rewrite on/off
ROUTER=on                                       # Skip retrieval for chitchat on/off
ONLINE_EVAL=on                                  # Grade answers in background on/off
